# Dudidam local development environment template
# Copy values into Windows environment variables or your secure secret manager.
# Never commit real keys.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

XAI_API_KEY=
XAI_MODEL=grok-4.6

GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

ASKCODI_API_KEY=
ASKCODI_MODEL=

# GitHub Copilot CLI: OAuth login is preferred for interactive desktop use.
# For non-interactive use, a supported token may be supplied here.
COPILOT_GITHUB_TOKEN=

# Optional agent/MCP configuration
PIECES_MCP_URL=
DUDIDAM_PROJECT_ROOT=

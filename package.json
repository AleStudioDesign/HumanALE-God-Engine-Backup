{
  "name": "dudidam-binary-assistant",
  "private": true,
  "version": "2.3.0",
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs",
    "desktop": "electron desktop/main.cjs",
    "verify": "npm test && npm run build",
    "package:desktop": "install-electron --no && node package-desktop.mjs",
    "package:installer": "npx --yes electron-builder@26.16.1 --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.4.3"
  },
  "main": "desktop/main.cjs"
}
